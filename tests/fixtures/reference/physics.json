  "integration": {
    "order": "Euler runs before ControlSprite. Forces written this tick apply on the next Euler. Euler then clears forces.",
    "body": [
      "Fy += GravityMultiplier * Grav",
      "S = Forces * OneOverMass * TimeStep^2",
      "Velocity += S",
      "Pos += Velocity",
      "Velocity *= EDamping",
      "Forces = 0"
    ],
    "withBodyDefaults": {
      "GravityMultiplier": 1,
      "OneOverMass": 1,
      "TimeStep": 1,
      "EDamping": 0.99,
      "Grav": 0.06
    },
    "damping": "Velocity is multiplied by EDamping after the position update, so this step's displacement uses the undamped velocity.",
    "aliveSkeleton": "Verlet on constraint pairs only. Pos = (1+VDamping)*Pos - VDamping*OldPos + Forces*invMass*dt^2. Live VDamping is 0.9945. Verlet does not use EDamping.",
    "afterUpdate": "Each velocity axis is clamped to MAX_VELOCITY 11."
  },
  "jet": {
    "storedAs": "JetsCount SmallInt, not a float tank",
    "capacity": "Map.StartJet = 119 * MapFile.StartJet div 100",
    "drain": "Dec once per ControlSprite while Jetpack and JetsCount > 0. Client only: if that leaves 1 and jet is still held, set 0. Server does not.",
    "thrustGround": "Forces.Y = -2.5 * JETSPEED when Grav > 0.05, else Grav*2",
    "thrustAir": "Forces.Y -= JETSPEED when Grav > 0.05, else Grav*2",
    "thrustProneAir": "Forces.X += Direction * JETSPEED / 2 when Grav > 0.05, else Grav*2",
    "regen": "If JetsCount < Map.StartJet and jet is not held, Inc. Every tick on ground. In air only when MainTickCounter mod 2 = 0.",
    "parachuteAlive": "Forces.Y = PARA_SPEED"
  },
