{$SITE_ADDRESS} {
    encode zstd gzip
    @api path /ws /health /metrics
    reverse_proxy @api api:3000
    root * /srv
    try_files {path} /index.html
    file_server
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
