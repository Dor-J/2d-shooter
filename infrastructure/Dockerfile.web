FROM rust:1.88-bookworm AS wasm
RUN rustup target add wasm32-unknown-unknown && cargo install wasm-pack --version 0.13.1 --locked
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY apps/api ./apps/api
RUN wasm-pack build crates/game-core --target web --release --out-dir ../../apps/web/public/wasm --out-name game_core
FROM node:22-bookworm AS web
WORKDIR /src/apps/web
COPY apps/web/package*.json ./
COPY apps/web/scripts/install-hooks.mjs ./scripts/install-hooks.mjs
RUN npm ci
COPY apps/web ./
COPY --from=wasm /src/apps/web/public/wasm ./public/wasm
RUN npm run build
FROM caddy:2-alpine
COPY infrastructure/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /src/apps/web/dist /srv
EXPOSE 80 443
